{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run api:generate",
    "dev": "next dev",
    "prebuild": "npm run api:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:routing": "node --test tests/public-host.test.mjs tests/http-test-config.test.mjs",
    "test:routing:http": "node --test tests/public-routing-http.test.mjs",
    "test:auth": "node ../validation/client-auth-routing.cjs",
    "test:auth:http": "node ../validation/client-auth-http.cjs",
    "test:booking": "node ../validation/booking-state.cjs",
    "test:booking:http": "node ../validation/booking-http.cjs",
    "test:appointments": "node ../validation/client-appointments-state.cjs",
    "test:appointments:http": "node ../validation/client-appointments-http.cjs",
    "test:barber": "node ../validation/barber-demo-state.cjs",
    "test:pwa": "node ../validation/pwa-policy.cjs",
    "test:pwa:browser": "node ../validation/pwa-browser.cjs",
    "test:pwa:lifecycle": "node ../validation/pwa-lifecycle.cjs",
    "api:generate": "orval --config ./orval.config.ts",
    "api:watch": "orval --config ./orval.config.ts --watch",
    "test:profiles": "node ../validation/profile-help-state.cjs",
    "test:profiles:browser": "node ../validation/profile-help-browser.cjs",
    "test:superadmin": "node ../validation/superadmin-state.cjs",
    "test:superadmin:browser": "node ../validation/superadmin-browser.cjs",
    "test:superadmin:registration:browser": "node ../validation/superadmin-registration-browser.cjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "msw": "^2.15.0",
    "orval": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
